<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidManifest — app I See Life Android (épico 8.0).
     Câmera obrigatória; vibração p/ feedback de disparo (spec 8.6/20). Sem permissão de rede
     (local-first, princípio 0.3). Sem WRITE_EXTERNAL_STORAGE em Android 10+ (usa MediaStore). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Google Play Billing (compra única, épico 8.7). -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Escrita em storage só p/ salvar em Android 9 e anterior; Android 10+ usa MediaStore. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ISeeLife"
        tools:targetApi="31">

        <!-- Activity única (single-activity + Compose). Retrato apenas (spec 17). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.ISeeLife">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Shortcut estático "Disparar" (épico 8.10) — abre no visor do Rua. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Quick Settings Tile (épico 8.10) — equivalente ao Control do iOS 18. Registrado
             aqui; a classe é implementada no épico 8.10. Comentado até existir a classe. -->
        <!--
        <service
            android:name=".plataforma.DispararTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_disparar"
            android:label="@string/tile_disparar"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        -->
    </application>
</manifest>
